{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": []
  },
  "include": ["types/**/*.d.ts", "js/**/*.js"],
  "exclude": ["node_modules", "vendor", "backup_*", "quarantine", "tools"]
}